# ============================================================
# Git で管理しない（コミットしない）ファイル
# ============================================================

# --- Windows が自動で作るファイル ---
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Mac が自動で作るファイル ---
.DS_Store
._*

# --- VS Code の個人設定（共有する extensions.json だけは管理する） ---
.vscode/*
!.vscode/extensions.json

# --- Office などの一時ファイル ---
~$*
*.tmp
*.bak
*.swp

# --- ログ・ダウンロードしたまとめファイル ---
*.log
*.zip

# --- 秘密情報（キーやパスワードを書いたファイルは絶対にコミットしない） ---
.env
.env.*
*.secret
secrets/

# --- 将来 Node.js などを使った場合に作られるフォルダ ---
node_modules/
